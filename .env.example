# URL structure. B = /sydney/ and /melbourne/ folders (launch setting, D-23). A = today's URLs (fallback).
URL_MODE=B

# "production" only on the live site. Anything else is noindex and (if the two values below are set) password-protected.
SITE_ENV=staging
STAGING_USER=
STAGING_PASSWORD=

# The one public host. Other hosts for the same site 301 to it (production only).
CANONICAL_HOST=www.nolanlawyers.com.au

# One GTM container only (Q-12).
NEXT_PUBLIC_GTM_ID=

# Live Google reviews and rating (never hard-coded, D-37).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID_SYDNEY=
GOOGLE_PLACE_ID_MELBOURNE=

# Enquiry form delivery (to be supplied).
ENQUIRY_WEBHOOK_URL=

# Review board at /review/ (staging only; see docs/review-board.md).
# Where ticks and notes are saved. Without these the board is read-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The email Ben gets for each tick or note. Without these, feedback is saved but no email is sent.
RESEND_API_KEY=
REVIEW_NOTIFY_EMAIL=
# Optional. Needs a domain verified in Resend; leave blank to use Resend's test sender.
REVIEW_FROM_EMAIL=
