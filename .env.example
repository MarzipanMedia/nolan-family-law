# URL structure. B = /sydney/ and /melbourne/ folders (launch setting, D-23). A = today's URLs (fallback).
URL_MODE=B

# "production" only on the live site. Anything else is noindex and (if the two values below are set) password-protected.
SITE_ENV=staging
STAGING_USER=
STAGING_PASSWORD=

# The one public host. Other hosts for the same site 301 to it (production only).
CANONICAL_HOST=www.nolanlawyers.com.au

# One GTM container only (Q-12).
NEXT_PUBLIC_GTM_ID=

# Live Google reviews and rating (never hard-coded, D-37).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID_SYDNEY=
GOOGLE_PLACE_ID_MELBOURNE=

# Enquiry form delivery (to be supplied).
ENQUIRY_WEBHOOK_URL=
